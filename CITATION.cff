    given-names: Vijay Prasad
    orcid: "https://orcid.org/0009-0004-1192-6906"
    affiliation: "Independent Researcher, Plainsboro, NJ, USA"
    email: vijay@vijayjavvadiresearch.ai
version: 4.6.5
date-released: "2026-11-03"
license: MIT
repository-code: "https://github.com/javvadivijayprasad/bdd2pw"
url: "https://github.com/javvadivijayprasad/bdd2pw#readme"
