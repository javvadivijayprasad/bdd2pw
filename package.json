{
  "name": "@vijaypjavvadi/bdd2pw",
  "version": "1.0.1",
  "description": "Scaffold runnable Playwright TypeScript tests from Gherkin .feature files. Detects existing Page Objects, scans live pages via Microsoft Playwright MCP, emits POMs + specs, ready for execution. CLI + HTTP service. Optional governed LLM fallback (Anthropic / OpenAI / Gemini).",
  "bin": {
    "bdd2pw": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javvadivijayprasad/bdd2pw.git"
  },
  "homepage": "https://github.com/javvadivijayprasad/bdd2pw#readme",
  "bugs": {
    "url": "https://github.com/javvadivijayprasad/bdd2pw/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "serve": "node dist/server.js",
    "dev": "ts-node src/cli.ts",
    "dev:serve": "ts-node src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:update": "vitest run -u",
    "verify": "tsc && node scripts/verify.js",
    "prepublishOnly": "npm run build && npm test",
    "lint": "eslint . --ext .ts && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "playwright",
    "bdd",
    "gherkin",
    "cucumber",
    "page-object",
    "test-automation",
    "scaffold",
    "mcp"
  ],
  "author": {
    "name": "Vijay Prasad",
    "email": "jvijayprasad@gmail.com",
    "url": "https://github.com/javvadivijayprasad"
  },
  "license": "MIT",
  "dependencies": {
    "@cucumber/gherkin": "^28.0.0",
    "@cucumber/messages": "^24.1.0",
    "@vijaypjavvadi/pw-emit": "^1.0.0",
    "archiver": "^7.0.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "pino": "^9.0.0",
    "ts-morph": "^22.0.0",
    "ulid": "^2.3.0",
    "undici": "^6.19.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "better-sqlite3": "^11.0.0",
    "pino-pretty": "^11.0.0",
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
